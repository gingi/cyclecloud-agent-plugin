{
    "name": "cyclecloud-agent-plugin",
    "version": "0.4.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
    },
    "scripts": {
        "package:local": "node scripts/package-local.mjs",
        "package:release": "npm run package:local && node scripts/package-release.mjs",
        "release:prepare": "node scripts/prepare-release.mjs",
        "release:tag": "node scripts/tag-release.mjs",
        "release:promote": "node scripts/promote-stable.mjs",
        "verify:release": "node scripts/verify-release.mjs",
        "test:inspect": "python3 -B -m unittest discover -s tests/python",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "audit": "npm audit --audit-level=high",
        "verify": "node scripts/verify.mjs",
        "verify:package": "node scripts/verify-package.mjs"
    },
    "devDependencies": {
        "@types/node": "20.19.11",
        "@vitest/coverage-v8": "4.1.11",
        "eslint": "9.36.0",
        "prettier": "3.6.2",
        "typescript": "5.9.2",
        "typescript-eslint": "8.44.1",
        "vitest": "4.1.11"
    }
}
