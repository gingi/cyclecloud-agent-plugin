{
    "name": "cyclecloud-mcp",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
    },
    "scripts": {
        "build": "node scripts/build.mjs",
        "package:local": "npm run build && node scripts/package-local.mjs",
        "install:local": "npm run package:local && sh dist/cyclecloud-mcp/install.sh --local",
        "deploy": "npm run build && node scripts/deploy.mjs deploy",
        "restore": "node scripts/deploy.mjs restore",
        "reset:dev": "python3 -B scripts/reset-dev.py",
        "reset:dev:apply": "python3 -B scripts/reset-dev.py --apply",
        "test:reset": "python3 -B -m unittest discover -s tests -p test_reset_dev.py",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format:check": "prettier --check .",
        "pretest": "npm run build",
        "test": "vitest run",
        "pretest:coverage": "npm run build",
        "test:coverage": "vitest run --coverage",
        "audit": "npm audit --audit-level=high",
        "verify": "node scripts/verify.mjs",
        "verify:package": "node scripts/verify-package.mjs"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "1.30.0",
        "undici": "6.28.0",
        "zod": "3.25.76"
    },
    "devDependencies": {
        "@types/node": "20.19.11",
        "@vitest/coverage-v8": "4.1.11",
        "esbuild": "0.28.2",
        "eslint": "9.36.0",
        "prettier": "3.6.2",
        "typescript": "5.9.2",
        "typescript-eslint": "8.44.1",
        "vitest": "4.1.11"
    }
}
