  },
  "devDependencies": {
    "@types/node": "20.19.11",
    "@vitest/coverage-v8": "4.1.11",
    "esbuild": "0.28.2",
    "eslint": "9.36.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "vitest": "4.1.11"
  }
